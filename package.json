{
  "name": "userscript-master-button",
  "version": "2.0.0-alpha.3",
  "private": true,
  "type": "module",
  "description": "Fresh Safari Userscripts rebuild with original-source decisions and explicitly experimental local filtering.",
  "scripts": {
    "experiment": "node experiments/filtering/run.mjs",
    "test": "node --test tests/*.test.mjs",
    "prototype": "node scripts/serve.mjs",
    "build:prototype": "node scripts/build-prototype.mjs",
    "build": "node scripts/build.mjs",
    "evaluate:development": "MB_SPLIT=development node experiments/evaluation/run.mjs",
    "evaluate:heldout": "MB_SPLIT=held-out node experiments/evaluation/run.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@huggingface/tokenizers": "0.2.0",
    "@huggingface/transformers": "4.3.1",
    "defuddle": "0.19.5",
    "linkedom": "0.18.12",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "jsdom": "29.0.1",
    "lucide": "1.56.0"
  }
}
